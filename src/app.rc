#include <windows.h>

1 ICON "icon.ico"

1 VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILEFLAGSMASK   0x3fL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404b0"
    BEGIN
      VALUE "CompanyName",      "AutoOpenApps"
      VALUE "FileDescription",  "AutoOpenApps - Startup App Launcher"
      VALUE "FileVersion",      "2.0.0.0"
      VALUE "ProductName",      "AutoOpenApps"
      VALUE "ProductVersion",   "2.0.0.0"
      VALUE "OriginalFilename", "AutoOpenApps.exe"
      VALUE "LegalCopyright",   "Copyright (c) 2026 PepsiColaya"
      VALUE "License",          "PolyForm Noncommercial 1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0804, 1200
  END
END

1 24 "app.manifest"
